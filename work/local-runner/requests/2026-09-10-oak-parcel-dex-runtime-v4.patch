+-- Task-bounded command bridge for ReceiveDexScene.  This deliberately uses
+-- the existing ObjectEventState forced-step primitive and live Lab templates;
+-- it does not add generic script/addobject semantics.
+world.findLiveNpc = function(localId)
+  for _, npc in ipairs(world.npcs) do
+    if npc.localId == localId then return npc end
+  end
+  return nil
+end
+
+world.removeNpcLivePreserveFlag = function(localId)
+  local kept = {}
+  for _, npc in ipairs(world.npcs) do
+    if npc.localId ~= localId then kept[#kept + 1] = npc end
+  end
+  world.npcs = kept
+end
+
+world.spawnOakParcelDexRival = function(spawn)
+  local existing = world.findLiveNpc(spawn.localId)
+  if existing then return existing end
+  local templates = world.mapObjectEventTemplates or {}
+  local template, i = nil, 0
+  while templates[i] ~= nil do
+    if templates[i].localId == spawn.localId then template = templates[i]; break end
+    i = i + 1
+  end
+  if not template then return nil, "rival_template_missing" end
+  local built = ObjectEventState.new({ [0]=template }, { rng=world.globalRng, isBlocked=isWalkTileBlocked })
+  local rival = built[1]
+  if not rival then return nil, "rival_template_unbuildable" end
+  rival.x, rival.y = spawn.x, spawn.y
+  rival.initialX, rival.initialY = spawn.x, spawn.y
+  rival.destX, rival.destY = spawn.x, spawn.y
+  rival.moving, rival.stepFrame, rival.moveDx, rival.moveDy = false, 0, 0, 0
+  world.npcs[#world.npcs + 1] = rival
+  return rival
+end
+
+world.handleOakParcelDexPresentationCommand = function(command)
+  if not command then return end
+  local function setText(pointer)
+    world.oakParcelDexPrinter = TextPrinterState.new(tokenizeTextAt(pointer), FONT_REVEAL_TICKS_PER_CHAR)
+    world.dialogueBuiltTokenIndex = -1
+  end
+  if command.kind == "lock" then
+    setText(command.textPointer)
+  elseif command.kind == "show_text" then
+    setText(command.textPointer)
+  elseif command.kind == "reveal_text" and world.oakParcelDexPrinter then
+    world.oakParcelDexPrinter:revealAll()
+    world.dialogueBuiltTokenIndex = -1
+  elseif command.kind == "move" then
+    if command.group == "rival_arrival" then
+      local rival, reason = world.spawnOakParcelDexRival(command.spawn)
+      if not rival then
+        world.handleOakParcelDexPresentationCommand({kind="unlock", failed=true, reason=reason})
+        world.oakParcelDexPresentation.state = world.oakParcelDexPresentation.FAILED
+        return
+      end
+      playerMovement.facingDirection = PlayerMovement.DOWN
+      world.oakParcelDexMotion = {
+        kind="npc_steps", group=command.group, npc=rival,
+        directions={PlayerMovement.UP,PlayerMovement.UP,PlayerMovement.UP,PlayerMovement.UP,PlayerMovement.UP,PlayerMovement.UP},
+        index=1, playerFaceLeftAfter=88, ticks=0,
+      }
+    elseif command.group == "player_face_up" then
+      playerMovement.facingDirection = PlayerMovement.UP
+      world.oakParcelDexMotion = {kind="delay_complete", group=command.group, ticks=1}
+    elseif command.group == "oak_to_dex" then
+      local oak = world.findLiveNpc(Battle.OakParcelDexPresentation.OAK_LOCAL_ID)
+      world.oakParcelDexMotion = {kind="npc_steps", group=command.group, npc=oak,
+        directions={PlayerMovement.UP,PlayerMovement.LEFT}, index=1, ticks=0}
+    elseif command.group == "dex_reveal" then
+      local oak = world.findLiveNpc(Battle.OakParcelDexPresentation.OAK_LOCAL_ID)
+      if oak then oak.facingDirection = PlayerMovement.UP end
+      world.removeNpcLivePreserveFlag(Battle.OakParcelDexPresentation.DEX_PROP_LEFT_LOCAL_ID)
+      world.oakParcelDexMotion = {kind="dex_reveal", group=command.group, stage=1, ticks=10}
+    elseif command.group == "oak_return" then
+      local oak = world.findLiveNpc(Battle.OakParcelDexPresentation.OAK_LOCAL_ID)
+      world.oakParcelDexMotion = {kind="npc_steps", group=command.group, npc=oak,
+        directions={PlayerMovement.RIGHT,PlayerMovement.DOWN}, index=1, ticks=0}
+    elseif command.group == "rival_exit" then
+      playerMovement.facingDirection = PlayerMovement.LEFT
+      local rival = world.findLiveNpc(Battle.OakParcelDexPresentation.RIVAL_LOCAL_ID)
+      world.oakParcelDexMotion = {kind="npc_steps", group=command.group, npc=rival,
+        directions={PlayerMovement.DOWN,PlayerMovement.DOWN,PlayerMovement.DOWN,PlayerMovement.DOWN,PlayerMovement.DOWN,PlayerMovement.DOWN},
+        index=1, ticks=0}
+    end
+  elseif command.kind == "unlock" then
+    world.oakParcelDexPrinter = nil
+    world.oakParcelDexMotion = nil
+    world.dialogueBuiltTokenIndex = -1
+    if command.remove then world.removeNpcLivePreserveFlag(command.remove.localId) end
+    if command.done then
+      addLine("Oak Parcel/Dex scene complete. Pokédex and five Poké Balls persisted; Viridian Mart is now open.")
+    else
+      addLine("Oak Parcel/Dex scene stopped: " .. tostring(command.reason))
+    end
+  end
+end
+
+world.oakParcelDexPresentationTask = function(taskId)
+  local presenter = world.oakParcelDexPresentation
+  if not presenter or not presenter:isActive() then return end
+  local motion = world.oakParcelDexMotion
+  if motion then
+    if motion.kind == "delay_complete" then
+      motion.ticks = motion.ticks - 1
+      if motion.ticks <= 0 then
+        world.oakParcelDexMotion = nil
+        world.handleOakParcelDexPresentationCommand(presenter:movementComplete(motion.group))
+      end
+      return
+    elseif motion.kind == "dex_reveal" then
+      motion.ticks = motion.ticks - 1
+      if motion.ticks <= 0 and motion.stage == 1 then
+        world.removeNpcLivePreserveFlag(Battle.OakParcelDexPresentation.DEX_PROP_RIGHT_LOCAL_ID)
+        motion.stage, motion.ticks = 2, 25
+      elseif motion.ticks <= 0 then
+        world.oakParcelDexMotion = nil
+        world.handleOakParcelDexPresentationCommand(presenter:movementComplete(motion.group))
+      end
+      return
+    elseif motion.kind == "npc_steps" then
+      motion.ticks = motion.ticks + 1
+      if motion.playerFaceLeftAfter and motion.ticks >= motion.playerFaceLeftAfter then
+        playerMovement.facingDirection = PlayerMovement.LEFT
+        motion.playerFaceLeftAfter = nil
+      end
+      if not motion.npc then
+        world.handleOakParcelDexPresentationCommand({kind="unlock", failed=true, reason="movement_target_missing"})
+        presenter.state = presenter.FAILED
+        return
+      end
+      if motion.npc.moving then
+        if ObjectEventState.advanceStep(motion.npc) then motion.index = motion.index + 1 end
+      elseif motion.index <= #motion.directions then
+        ObjectEventState.beginForcedStep(motion.npc, motion.directions[motion.index])
+      else
+        world.oakParcelDexMotion = nil
+        world.handleOakParcelDexPresentationCommand(presenter:movementComplete(motion.group))
+      end
+      return
+    end
+  end
+  local printer = world.oakParcelDexPrinter
+  if not printer then return end
+  local aPressed = inputState:isNewlyPressed(InputState.A_BUTTON)
+  if aPressed then
+    world.handleOakParcelDexPresentationCommand(presenter:onA(true, printer:isFullyRevealed()))
+  else
+    printer:tick(false)
+  end
+end
