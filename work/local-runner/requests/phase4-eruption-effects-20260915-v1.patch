+    local dynamicMove = {}
+    for k, v in pairs(move) do dynamicMove[k] = v end
+    dynamicMove.power = BattleEngine.eruptionPowerFromHP(attacker.hp, attacker.maxHP, move.power)
+    move = dynamicMove
+  end
 
