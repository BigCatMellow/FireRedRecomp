+      player=BattleEngine.makeBattler({species=1,level=20,stats=stats,types={10,10},moves={{move=33,pp=35}}}),
+      foe=BattleEngine.makeBattler({species=4,level=20,stats=stats,types={10,10},moves={{move=33,pp=35}}}),
