+    moves[id]=original
+  end
+  b,a,d=setup(26,"player",{4321}); a.moves={{move=26,pp=0},{move=33,pp=1}}; ev=resolve(b,"player")
+  check("effect45 selected zero PP retained",kinds(ev)=="noPP" and a.hp==100 and b.rng.draws==0)
