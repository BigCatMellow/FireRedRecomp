+  for _,id in ipairs({26,136}) do
+    for _,side in ipairs({"player","foe"}) do
+      local b,a,d=setup(id,side)
+      local ev=resolve(b,side)
+      -- Lv20: (10*70/50)+2=16; STAB=24; half=12.
